{
  "manifest_version": 3,
  "name": "Logbook",
  "version": "1.0.0",
  "description": "Logbook kontrol paneli: Pano, Yapılacaklar, Ajanda, Defter ve Finans takibi.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "unlimitedStorage",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "uzanti/content_sync.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Logbook'u Aç",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "uzanti/background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Logbook Hızlı Not Penceresini Aç"
    },
    "open-quick-note": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "Logbook Hızlı Not Penceresini Her Yerden Aç"
    }
  }
}
